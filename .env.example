# Copy to .env for local development. No S3 account is needed locally.
DEV=true
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wikiware
WIKI_NAME=Starship Wiki
CSRF_SECRET_KEY=
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Optional S3-compatible storage. Set all three together to enable it.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=wikiware
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=
